# ESP-IDF build artifacts
build/
sdkconfig.old

# Component Manager: the fetched package source is a cache, not source --
# ignored like node_modules. dependencies.lock is NOT ignored (see below):
# it's what pins the exact resolved version + content hash for a
# reproducible build, same role as package-lock.json/Cargo.lock.
managed_components/

# Keep sdkconfig.defaults tracked; ignore the generated local sdkconfig
# so per-machine build quirks don't get committed.
sdkconfig

# Personal infra details — never tracked (server-side context only; no
# firmware secrets live in any file — see CLAUDE.md constraint #2).
CLAUDE.local.md

# Editor / OS cruft
.vscode/
.DS_Store

# Python
__pycache__/
*.pyc

# gitleaks report output, if generated locally
gitleaks-report.json

# This is covered by my global gitignore, but in case it's not for someone else:
.claude/settings.local.json