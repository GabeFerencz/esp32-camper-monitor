// Copy this file to secrets.h (gitignored) and fill in real values.
// secrets.h is never committed — see .gitignore and the pre-commit
// gitleaks hook, which both enforce this.

#pragma once

// WiFi credentials for the site's private network
#define WIFI_SSID       "your-network-name"
#define WIFI_PASSWORD   "your-network-password"

// Phone-home endpoint — a Cloudflare Tunnel hostname in production.
// Never use a real personal domain here in the tracked example file.
#define PHONE_HOME_HOST "your-endpoint.example.com"

// Cloudflare Access service token (Service Auth policy, not browser SSO —
// this device is headless). Sent as CF-Access-Client-Id /
// CF-Access-Client-Secret headers on every request.
#define CF_ACCESS_CLIENT_ID     "your-client-id"
#define CF_ACCESS_CLIENT_SECRET "your-client-secret"
