# Board profile: ESP32-WROOM-32 DEVKITV1, 4MB flash, Boya flash chip.
# See CLAUDE.md for why these are pinned rather than left at IDF default.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

# TLS: trusted root certificate bundle, needed for esp_crt_bundle_attach()
# in phone_home_sender.c to validate the Cloudflare-fronted HTTPS
# endpoint. Already IDF's own default; pinned explicitly per this file's
# convention of not relying on undocumented defaults.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# Custom partition table (see partitions.csv for the dual ota_0/ota_1
# layout and sizing rationale) -- replaces the default single-app
# table ahead of OTA/Bluetooth work. See issue #13.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Brownout detector: hardware reset when supply voltage sags below the
# selected threshold. Already IDF's own default (enabled, lowest
# detection level); pinned explicitly per this file's convention of not
# relying on undocumented defaults, and because SPEC.md calls out
# brownout detection as a non-negotiable reliability requirement for
# this device's unattended operation. See issue #34.
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_0=y
